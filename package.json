{
  "name": "multimodality-questionnaire-github-preview",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w frontend",
    "test": "npm run test -w frontend && npm run test:netlify-export && npm run test:randomization",
    "test:netlify-export": "tsx --test scripts/tests/netlify-forms-export.test.mjs",
    "test:randomization": "tsx --test scripts/tests/randomization-*.test.mjs netlify/functions/tests/*.test.mts",
    "export:netlify": "tsx scripts/netlify-forms-export.mjs",
    "randomization:generate": "node scripts/randomization/generate-private-schedule.mjs",
    "randomization:validate": "node scripts/randomization/validate-private-schedule.mjs",
    "randomization:import": "node scripts/randomization/import-private-schedule.mjs",
    "randomization:export-ledger": "node scripts/randomization/export-randomization-ledger.mjs"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1"
  },
  "dependencies": {
    "@netlify/database": "^1.1.0"
  }
}
