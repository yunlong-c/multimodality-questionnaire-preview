# The randomization schedule is a private allocation-concealment artifact.
# Only its one-way public metadata/hash under netlify/randomization is tracked.
.private/
private/
**/private-schedule*.json
**/randomization-schedule*.private.json
**/randomization-seed*

# The static questionnaire requires this reviewed public runtime catalog.
# Whitelist only the exact TypeScript inputs needed by the browser build;
# private outcome catalogs and arbitrary data directories remain ignored.
!frontend/src/data/
!frontend/src/data/manifestSelectors.ts
!frontend/src/data/manifestTypes.ts
!frontend/src/data/officialManifest.ts
!frontend/src/data/releaseInfo.ts
!frontend/src/data/sequenceCatalog.generated.ts
!frontend/src/data/videoPlaybackManifest.generated.ts

